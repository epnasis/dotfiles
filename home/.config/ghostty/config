# ==============================================================================
# General
# ==============================================================================

term = xterm-256color

# ==============================================================================
# Typography & Theme
# ==============================================================================
theme = "Catppuccin Mocha"
font-family = PragmataPro Mono Liga
font-size = 14
font-thicken = true

# ==============================================================================
# Window & Platform (macOS)
# ==============================================================================
macos-option-as-alt = left
macos-non-native-fullscreen = true
macos-titlebar-proxy-icon = hidden
fullscreen = false
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
confirm-close-surface = false
#background-opacity = 0.2
background-blur = true

# ==============================================================================
# Clipboard & Mouse
# ==============================================================================
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
mouse-hide-while-typing = true

# ==============================================================================
# Shell Integration
# ==============================================================================
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path

# ==============================================================================
# Splits (Appearance & Navigation)
# ==============================================================================
split-divider-color = #89b4fa
unfocused-split-opacity = 0.5

keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+j=goto_split:down
keybind = cmd+shift+k=goto_split:up
keybind = cmd+shift+l=goto_split:right

# ==============================================================================
# Quake / Quick Terminal
# ==============================================================================
keybind = global:cmd+shift+semicolon=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 40%
quick-terminal-screen = main
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15
quick-terminal-space-behavior = move

# ==============================================================================
# Notifications
# ==============================================================================
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s
notify-on-command-finish-action = notify,bell
desktop-notifications = true

# ==============================================================================
# Custom Keybindings
# ==============================================================================
keybind = cmd+r=clear_screen
keybind = cmd+k=jump_to_prompt:-1
keybind = cmd+j=jump_to_prompt:1
keybind = cmd+shift+y=write_scrollback_file:open,plain
keybind = cmd+shift+u=toggle_background_opacity
